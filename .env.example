NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=voltxpress

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Legacy (kept for backward compat)
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin seed
SEED_ADMIN_NAME=VoltXpress Admin
SEED_ADMIN_EMAIL=admin@voltxpress.test
SEED_ADMIN_PASSWORD=Admin123!

# SMS (optional — logs to console by default in dev)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=VoltXpress

# Admin Notifications — Telegram Bot (recommended, free, instant)
# Setup:
# 1. Search @BotFather on Telegram, send /newbot, get your token
# 2. Start a chat with your new bot
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_WHATSAPP=+923001234567
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Admin Notifications
ADMIN_EMAIL=admin@voltxpress.test
ADMIN_WHATSAPP=whatsapp:+923371694830

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe (Card Payments)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
SMTP_FROM=VoltXpress <noreply@voltxpress.test>

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction

# Easypaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENDPOINT=https://easypay.easypaisa.com.pk/easypay/Index.jsf
